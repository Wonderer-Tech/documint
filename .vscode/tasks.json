{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Launch Extension Host (No Debugger)",
      "type": "process",
      "command": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--new-window",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    }
  ]
}
