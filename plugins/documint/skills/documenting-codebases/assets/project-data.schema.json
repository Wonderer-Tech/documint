{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocuMint embedded project map data",
  "type": "object",
  "required": ["projectName", "summary", "files", "modules", "edges", "readingPath", "referencedEnvironmentVariables", "provenance"],
  "properties": {
    "projectName": {"type": "string", "minLength": 1, "maxLength": 240},
    "summary": {
      "type": "object",
      "required": ["files", "lines", "describedFiles", "undocumentedFiles", "symbols", "exports", "internalDependencies", "externalDependencies", "todos", "languages", "entryPoints", "externalDependencyNames"],
      "properties": {
        "files": {"type": "integer", "minimum": 1},
        "lines": {"type": "integer", "minimum": 0},
        "describedFiles": {"type": "integer", "minimum": 0},
        "undocumentedFiles": {"type": "integer", "minimum": 0},
        "symbols": {"type": "integer", "minimum": 0},
        "exports": {"type": "integer", "minimum": 0},
        "internalDependencies": {"type": "integer", "minimum": 0},
        "externalDependencies": {"type": "integer", "minimum": 0},
        "todos": {"type": "integer", "minimum": 0},
        "languages": {"type": "array", "items": {"type": "object", "required": ["name", "files", "lines"], "properties": {"name": {"type": "string"}, "files": {"type": "integer", "minimum": 0}, "lines": {"type": "integer", "minimum": 0}}}},
        "entryPoints": {"type": "array", "items": {"type": "string"}},
        "externalDependencyNames": {"type": "array", "items": {"type": "string"}}
      }
    },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "module", "language", "lines", "exports", "internalSymbols", "todos", "environmentVariables", "uses", "usedBy", "entryPoint"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "module": {"type": "string"},
          "language": {"type": "string"},
          "lines": {"type": "integer", "minimum": 0},
          "description": {"type": "string"},
          "descriptionSource": {"type": "string"},
          "exports": {"type": "array", "items": {"$ref": "#/definitions/symbol"}},
          "internalSymbols": {"type": "array", "items": {"$ref": "#/definitions/symbol"}},
          "todos": {"type": "array", "items": {"type": "object", "required": ["line", "text"], "properties": {"line": {"type": "integer", "minimum": 1}, "text": {"type": "string"}}}},
          "environmentVariables": {"type": "array", "items": {"type": "string"}},
          "uses": {"type": "array", "items": {"type": "string"}},
          "usedBy": {"type": "array", "items": {"type": "string"}},
          "entryPoint": {"type": "boolean"}
        }
      }
    },
    "modules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "primaryFilePaths", "files", "lines"], "properties": {"name": {"type": "string"}, "primaryFilePaths": {"type": "array", "items": {"type": "string"}}, "files": {"type": "integer", "minimum": 1}, "lines": {"type": "integer", "minimum": 0}, "description": {"type": "string"}, "descriptionSource": {"type": "string"}}}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["from", "to", "count"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}}},
    "readingPath": {"type": "array", "items": {"type": "object", "required": ["path", "reason"], "properties": {"path": {"type": "string"}, "reason": {"type": "string"}}}},
    "referencedEnvironmentVariables": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object", "required": ["source", "revision", "indexedFiles", "inspectedFiles", "analysisMode"], "properties": {"source": {"type": "string", "minLength": 1}, "revision": {"type": "string"}, "indexedFiles": {"type": "integer", "minimum": 0}, "inspectedFiles": {"type": "integer", "minimum": 0}, "analysisMode": {"enum": ["ai-assisted", "source-backed"]}, "notes": {"type": "string"}}},
    "documentationSections": {"type": "array", "items": {"type": "object", "required": ["heading"], "properties": {"heading": {"type": "string"}, "paragraphs": {"type": "array", "items": {"type": "string"}}, "items": {"type": "array", "items": {"type": "string"}}}}}
  },
  "definitions": {"symbol": {"type": "object", "required": ["name", "kind", "line"], "properties": {"name": {"type": "string"}, "kind": {"type": "string"}, "line": {"type": "integer", "minimum": 1}}}}
}
